#!/usr/bin/env bash

# Serialize actions so a delayed startup cannot undo a later privacy request.
exec 9>"${XDG_RUNTIME_DIR:?}/streaming-control.lock"
flock 9

notify_keys() {
  local output
  if output=$(stream keys "$1" 2>&1); then
    notify-send "Stream keys" "$output"
  else
    notify-send -u critical "Stream keys: action failed" "$output"
    return 1
  fi
}

case "$1" in
  start)
    if ! output=$(stream start 2>&1); then
      notify-send -u critical "Stream Studio: start failed" "$output"
      exit 1
    fi
    # systemd can report the service started before its control socket exists.
    for ((attempt = 0; attempt < 30; attempt++)); do
      if output=$(stream keys on 2>&1); then
        notify-send "Stream keys" "$output"
        if ! output=$(stream preview on 2>&1); then
          notify-send -u critical "Stream preview: enabling failed" "$output"
          exit 1
        fi
        omarchy launch or focus 'obs' 'uwsm-app -- obs' 9>&- &
        exit 0
      fi
      sleep 0.1
    done
    notify-send -u critical "Stream keys: enabling failed" "$output"
    exit 1
    ;;
  off)
    status=0
    notify_keys off || status=1
    if ! output=$(stream preview off 2>&1); then
      notify-send -u critical "Stream preview: disabling failed" "$output"
      status=1
    fi
    exit "$status"
    ;;
  toggle)
    notify_keys toggle
    ;;
  *)
    exit 2
    ;;
esac
